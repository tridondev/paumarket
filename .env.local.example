# Firebase client config — from Firebase Console > Project Settings > General > Your apps
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Comma-separated list of email domains allowed to sign up, e.g. ui.edu.ng,jkuat.ac.ke
# Leave blank to allow any email — PAU has no single shared student domain, so most
# deployments rely on the admin approval step (+ Student ID) instead of this.
NEXT_PUBLIC_ALLOWED_EMAIL_DOMAINS=
